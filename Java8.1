public class BreakContinueDemo {
    public static void main(String[] args) {

        for (int i = 1; i <= 10; i++) {

            if (i == 3) {
                continue; // пропускаем число 3
            }

            if (i == 7) {
                break; // прекращаем цикл при достижении 7
            }

            System.out.println("i = " + i);
        }
    }
}
