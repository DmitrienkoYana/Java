class Parent {
    protected int value = 10;

    public Parent(int val) {
        System.out.println("Parent constructor: val = " + val);
    }

    public void printValue() {
        System.out.println("Parent printValue(): " + value);
    }
}

class Child extends Parent {
    protected int value = 20; // поле с тем же именем, что и в суперклассе

    public Child(int parentVal, int childVal) {
        super(parentVal); // (1) Вызов конструктора суперкласса
        this.value = childVal;
        System.out.println("Child constructor: value = " + this.value);
    }

    public void show() {
        System.out.println("Child value: " + this.value);
        System.out.println("Parent value: " + super.value); // (2) Доступ к полю суперкласса

        super.printValue(); // (3) Вызов метода суперкласса
    }
}

public class SuperDemo {
    public static void main(String[] args) {
        Child c = new Child(100, 200);
        c.show();
    }
}
