class A {
    int a;
    int b;
    int c;
    int z;

    public A() {
        z = 1;
    }

    public A(int a) {
        this();          // вызывает конструктор A()
        this.a = a;
    }

    public A(int a, int b) {
        this(a);         // вызывает конструктор A(int a)
        this.b = b;
    }

    public A(int a, int b, int c) {
        this(a, b);      // вызывает конструктор A(int a, int b)
        this.c = c;
    }
}
