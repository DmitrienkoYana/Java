class Parent {
    void printMessage() {
        System.out.println("Parent message");
    }

    void draw(int x) {
        System.out.println("Drawing: " + x);
    }
}

class Child extends Parent {

    // --- 1. Ошибка в имени метода ---
    @Override
    void printMesage() {      // Ошибка: метод Родителя называется printMessage()
        System.out.println("Child message");
    }

    // --- 2. Неправильная сигнатура ---
    @Override
    void draw(double x) {     // Ошибка: Родитель имеет draw(int x)
        System.out.println("Drawing double: " + x);
    }
}

public class OverrideErrorDemo {
    public static void main(String[] args) {
        // Код не выполнится, программа не скомпилируется!
        Parent p = new Child();
        p.printMessage();
        p.draw(10);
    }
}
