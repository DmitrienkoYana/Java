public class OverloadExample {

    // Метод 1 — один параметр int
    void print(int a) {
        System.out.println("print(int): " + a);
    }

    // Метод 2 — два параметра int
    void print(int a, int b) {
        System.out.println("print(int, int): " + a + ", " + b);
    }

    // Метод 3 — параметр double
    void print(double x) {
        System.out.println("print(double): " + x);
    }

    // Метод 4 — строковый параметр
    void print(String s) {
        System.out.println("print(String): " + s);
    }

    public static void main(String[] args) {
        OverloadExample ex = new OverloadExample();

        ex.print(10);
        ex.print(10, 20);
        ex.print(3.14);
        ex.print("Hello");
    }
}
