import java.util.Arrays;

public class ArraysDemo {
    public static void main(String[] args) {

        int[] a1 = {3, 1, 4, 1, 5};
        int[] a2 = {3, 1, 4, 1, 5};
        int[] a3 = {1, 2, 3, 4, 5};

        // - 1. toString(...) -
        System.out.println("toString: " + Arrays.toString(a1));
        

        // - 2. sort(...) -
        Arrays.sort(a1);
        System.out.println("after sort: " + Arrays.toString(a1));
        

        // - 3. binarySearch(...) -
        int index = Arrays.binarySearch(a1, 4);
        System.out.println("binarySearch (4): " + index);
        // Вывод: 3 (индекс найденного элемента)

        // - 4. equals(...) -
        System.out.println("a1 equals a2: " + Arrays.equals(a1, a2));
        // false, потому что a1 отсортирован, а a2 — нет

        System.out.println("a1 equals a3: " + Arrays.equals(a1, a3));
        // true, потому что a1 теперь [1,1,3,4,5] — те же данные

        // - 5. compare(...) -
        System.out.println("compare(a1, a3): " + Arrays.compare(a1, a3));
        // 0 => массивы равны лексикографически

        System.out.println("compare(a2, a3): " + Arrays.compare(a2, a3));
        // < 0 => a2 "меньше" лексикографически
    }
}
