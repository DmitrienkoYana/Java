interface A {
    default void hello() {
        System.out.println("Hello from A");
    }
}

interface B {
    default void hello() {
        System.out.println("Hello from B");
    }
}

class C implements A, B {

    @Override
    public void hello() {
        System.out.println("Resolving conflict:");
        A.super.hello();   // выбираем реализацию A
    }
}

public class DefaultMethodConflictDemo {
    public static void main(String[] args) {
        C c = new C();
        c.hello();
    }
}
