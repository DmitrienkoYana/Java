interface MyInterface {

    // Неабстрактный метод (default)
    default void defaultMethod() {
        System.out.println("Default method from interface");
    }

    // Статический метод интерфейса
    static void staticMethod() {
        System.out.println("Static method from interface");
    }
}

class MyClass implements MyInterface {
    // Реализация default-метода не обязательна
}

public class InterfaceMethodsDemo {
    public static void main(String[] args) {

        MyClass obj = new MyClass();
        MyInterface ref = obj;

        // 1. Вызов default-метода через объект класса
        obj.defaultMethod();

        //2. Вызов default-метода через ссылку на интерфейс
        ref.defaultMethod();

        //3. Вызов статического метода интерфейса
        MyInterface.staticMethod();

        // Ошибка компиляции:
        // obj.staticMethod();
        // ref.staticMethod();
    }
}
