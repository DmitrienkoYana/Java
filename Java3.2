public class Main {

    // Класс для демонстрации работы с объектами
    static class Person {
        private String name;
        private int age;

        Person(String name, int age) {
            this.name = name;
            this.age = age;
        }

        @Override
        public String toString() {
            return "Person{name='" + name + "', age=" + age + "}";
        }
    }

    public static void main(String[] args) {

        String text = "Информация: ";

        int number = 25;
        double price = 19.99;
        boolean active = true;

        Person person = new Person("Яна", 20);

        // Использование перегруженного оператора +
        String result =
                text +
                "\nЧисло: " + number +
                "\nЦена: " + price +
                "\nАктивен: " + active +
                "\nОбъект person: " + person;

        System.out.println(result);
    }
}
